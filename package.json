{
  "name": "@nijaru/pi-compactor",
  "version": "0.0.1",
  "description": "Pi extension that gives the LLM a compact tool for context management",
  "type": "module",
  "license": "MIT",
  "author": "Nick Naru <nick@nijaru.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/nijaru/pi-compactor.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "compaction"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/bun": "1.4.1",
    "typebox": "1.3.27",
    "typescript": "7.0.2"
  },
  "files": [
    "index.ts",
    "policy.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun test && bun run typecheck"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
